{
  "name": "patchmill",
  "version": "0.19.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "fixtures",
    "docs",
    "skills",
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "npm-shrinkwrap.json",
    "tsconfig.build.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rochecompaan/patchmill.git"
  },
  "keywords": [
    "pi-package",
    "ai",
    "llm",
    "cli",
    "automation",
    "triage",
    "software-factory",
    "orchestrator"
  ],
  "license": "Apache-2.0",
  "description": "An agent-driven software factory where humans and agents collaborate to preserve software craftsmanship.",
  "type": "module",
  "bin": {
    "patchmill": "dist/bin/patchmill.js"
  },
  "scripts": {
    "patchmill": "node bin/patchmill.ts",
    "triage": "node bin/patchmill.ts triage",
    "run-once": "node bin/patchmill.ts run-once",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "npm run format:check && npm run lint:ts && npm run lint:md",
    "lint:ts": "eslint \"{bin,src,test-support}/**/*.ts\" --max-warnings=0",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "node --test \"bin/*.test.ts\" \"src/**/*.test.ts\" \"test-support/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='bin/**/*.ts' --test-coverage-include='src/**/*.ts' --test-coverage-include='test-support/**/*.ts' --test-coverage-exclude='**/*.test.ts' \"bin/*.test.ts\" \"src/**/*.test.ts\" \"test-support/*.test.ts\"",
    "check:architecture": "depcruise --config dependency-cruiser.config.mjs bin src extensions",
    "check:coverage": "c8 node --test \"bin/*.test.ts\" \"src/**/*.test.ts\" \"test-support/*.test.ts\"",
    "check:crap": "npm run check:coverage && crap-ts score --skip-coverage --report-only",
    "check:crap:strict": "npm run check:coverage && crap-ts score --skip-coverage",
    "check:mutation": "stryker run",
    "check:property": "node --test \"quality/property/*.test.ts\"",
    "test:mutation": "node --test src/policy/todo-statuses.test.ts quality/property/todo-statuses.property.test.ts",
    "check:static": "eslint \"{bin,src,test-support,quality}/**/*.ts\" --max-warnings=0",
    "check:types": "tsc -p tsconfig.quality.json",
    "test:cli": "node --test bin/*.test.ts src/cli/main.test.ts",
    "test:triage": "node --test src/cli/commands/triage/*.test.ts",
    "test:run-once": "node --test src/cli/commands/run-once/*.test.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write",
    "{bin,src,test-support}/**/*.ts": "eslint --max-warnings=0",
    "*.md": "markdownlint-cli2"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.15.3"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "c8": "^12.0.0",
    "crap-ts": "^0.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "pi-subagents": "0.55.0",
    "superpowers": "https://github.com/obra/superpowers/archive/refs/tags/v6.3.0.tar.gz"
  }
}
