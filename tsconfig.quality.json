{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noCheck": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "types": ["node"]
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "test-support/**/*.ts",
    "scripts/**/*.ts",
    "web/**/*.js"
  ]
}
